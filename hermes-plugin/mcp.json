{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "agents-automations": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/dist/server.mjs",
        "--transport",
        "stdio",
        "--no-env"
      ],
      "env": {
        "AGENTS_AUTOMATIONS_HOME": "${PLUGIN_DATA}",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}",
        "GOOGLE_API_KEY": "${GOOGLE_API_KEY}",
        "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
        "AGENTS_AUTOMATIONS_EMAIL_ADDRESS": "${AGENTS_AUTOMATIONS_EMAIL_ADDRESS}",
        "AGENTS_AUTOMATIONS_EMAIL_APP_PASSWORD": "${AGENTS_AUTOMATIONS_EMAIL_APP_PASSWORD}",
        "AGENTS_AUTOMATIONS_EMAIL_IMAP_HOST": "${AGENTS_AUTOMATIONS_EMAIL_IMAP_HOST}",
        "AGENTS_AUTOMATIONS_EMAIL_IMAP_PORT": "${AGENTS_AUTOMATIONS_EMAIL_IMAP_PORT}",
        "AGENTS_AUTOMATIONS_EMAIL_TIMEOUT_MS": "${AGENTS_AUTOMATIONS_EMAIL_TIMEOUT_MS}",
        "AGENTS_AUTOMATIONS_MCP_COMMAND": "${AGENTS_AUTOMATIONS_MCP_COMMAND}",
        "AGENTS_AUTOMATIONS_MCP_TOOLS": "${AGENTS_AUTOMATIONS_MCP_TOOLS}",
        "AGENTS_AUTOMATIONS_MCP_TIMEOUT_MS": "${AGENTS_AUTOMATIONS_MCP_TIMEOUT_MS}",
        "AGENTS_AUTOMATIONS_ALLOW_BASH": "${AGENTS_AUTOMATIONS_ALLOW_BASH}",
        "AGENTS_AUTOMATIONS_ALLOW_WRITE": "${AGENTS_AUTOMATIONS_ALLOW_WRITE}",
        "AGENTS_AUTOMATIONS_ALLOW_WEB": "${AGENTS_AUTOMATIONS_ALLOW_WEB}",
        "AGENTS_AUTOMATIONS_ALLOW_EMAIL": "${AGENTS_AUTOMATIONS_ALLOW_EMAIL}",
        "AGENTS_AUTOMATIONS_ALLOW_MCP": "${AGENTS_AUTOMATIONS_ALLOW_MCP}",
        "AGENTS_AUTOMATIONS_ALLOW_FLOW_PATHS": "${AGENTS_AUTOMATIONS_ALLOW_FLOW_PATHS}"
      }
    }
  }
}
